<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (API 31+): fixed sample rows, so the picker never
     shows an empty card. RemoteViews-safe classes only. Same header and
     column widths as widget_hidescore.xml + widget_row.xml. Older launchers
     use drawable-nodpi/widget_preview.png. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="5dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginEnd="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Tomorrow"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_monkey" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="-3dp"
                android:importantForAccessibility="no"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="0dp"
                android:paddingBottom="7dp"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_muted" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="7:30 PM"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:gravity="center"
                android:maxLines="1"
                android:text="NHL"
                android:textColor="@color/widget_text"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="NYI"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_at"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="NYR"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="ESPN"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:text="Fri Oct 9"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="7:00 PM"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:gravity="center"
                android:maxLines="1"
                android:text="NCAAH"
                android:textColor="@color/widget_text"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="AKFB"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_at"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="BC"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="ESPN+"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="12:00 PM"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:gravity="center"
                android:maxLines="1"
                android:text="NFL"
                android:textColor="@color/widget_text"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="CHI"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_at"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="GB"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="NBC"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
