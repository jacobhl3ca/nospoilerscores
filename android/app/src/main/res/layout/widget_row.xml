<?xml version="1.0" encoding="utf-8"?>
<!-- One widget row: league chip · AWAY @ HOME · Tue 7:05 PM · channel.
     The channel cell has a fixed width so the times line up row to row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/row_league"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="34dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/widget_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_teams"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/row_channel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>
