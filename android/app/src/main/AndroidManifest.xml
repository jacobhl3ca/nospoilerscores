<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Native crash reporting (sentry-android auto-init). Reuses this app's
             existing Sentry project so native crashes land beside its web errors.
             Tracing is off: crashes and ANRs only, no performance quota. -->
        <meta-data android:name="io.sentry.dsn" android:value="https://b1d8b3efe70b8dbe7f865cd0b5dc832a@o4511667913818112.ingest.us.sentry.io/4511694546534400" />
        <meta-data android:name="io.sentry.environment" android:value="production" />
        <meta-data android:name="io.sentry.traces.sample-rate" android:value="0.0" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hidescore-auth" android:host="google" />
            </intent-filter>

            <!-- App Links. android:autoVerify makes Android fetch
                 https://hidescore.com/.well-known/assetlinks.json at install time; if
                 the SHA-256 there doesn't match the Play app-signing key, links keep
                 opening in Chrome instead. Check with:
                   adb shell pm get-app-links com.jacobhl.hidescore -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hidescore.com" />
                <data android:scheme="https" android:host="www.hidescore.com" />
            </intent-filter>

            <!-- Share sheet: "Share → HideScore" from the YouTube app (or any app
                 that shares text). MainActivity.loadSharedText opens /watch with
                 the shared text, and the page finds the YouTube link in it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ requires explicit <queries> for AppLauncher.canOpenUrl
         to return true on the youtube:// scheme. iOS handles the same need
         via LSApplicationQueriesSchemes in Info.plist. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="youtube" />
        </intent>
        <package android:name="com.google.android.youtube" />
    </queries>
</manifest>
